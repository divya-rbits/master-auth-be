# =============================================================================
# MASTER PASSWORD AUTHENTICATION BACKEND - PRODUCTION CONFIGURATION
# =============================================================================
#
# SECURITY WARNING: Never commit the actual .env file to version control!
# This is a template for production deployment. Copy and customize for your environment.
#
# Setup Instructions:
# 1. Copy this file to .env: cp .env.production.example .env
# 2. Replace all placeholder values with your actual production values
# 3. Ensure file permissions are restrictive: chmod 600 .env
# 4. Never expose these values in client-side code or logs
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port number for the server to listen on
# Type: Integer (1-65535)
# Required: Yes
# Default: 3001
# Example: 3001, 8080, 443
PORT=3001

# Application environment mode
# Type: String (development | staging | production)
# Required: Yes
# Default: development
# Production Value: production
# Impact: Controls error verbosity, logging level, and security features
NODE_ENV=production

# =============================================================================
# DATABASE CONFIGURATION (Supabase)
# =============================================================================

# Supabase project URL
# Type: URL
# Required: Yes
# Format: https://[project-id].supabase.co
# Example: https://abcdefghijklmnop.supabase.co
# Get from: Supabase Dashboard > Settings > API > Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service role key (secret key with full database access)
# Type: String (JWT)
# Required: Yes
# Security: CRITICAL - Never expose this key publicly!
# Get from: Supabase Dashboard > Settings > API > service_role key
# Note: This key bypasses Row Level Security (RLS) policies
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT signing secret for token generation and verification
# Type: String (minimum 32 characters recommended)
# Required: Yes
# Security: CRITICAL - Use a cryptographically secure random string
# Generate: openssl rand -base64 32
# Note: Changing this will invalidate all existing tokens
JWT_SECRET=your_production_jwt_secret_minimum_32_characters_long

# Token expiration time in seconds
# Type: Integer (seconds)
# Required: No
# Default: 3600 (1 hour)
# Recommended: 3600 (1 hour) to 86400 (24 hours)
# Note: Shorter is more secure, longer is more convenient
TOKEN_EXPIRATION=3600

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Comma-separated list of allowed origins for cross-origin requests
# Type: String (comma-separated URLs)
# Required: Yes for web applications
# Format: https://domain1.com,https://domain2.com
# Examples:
#   Production: https://yourdomain.com,https://app.yourdomain.com
#   Development: http://localhost:3000,http://localhost:5173
# Security: Only include trusted domains
# Note: No trailing slashes, no wildcards in production
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# =============================================================================
# ADMIN PANEL CREDENTIALS
# =============================================================================
# HTTP Basic Authentication for admin endpoints (/api/admin/*)
# Used for querying audit logs and administrative tasks

# Admin username for HTTP Basic Auth
# Type: String
# Required: Yes if using admin endpoints
# Recommended: Use a unique, non-obvious username
# Security: Change from default immediately
ADMIN_USERNAME=your_admin_username_here

# Admin password for HTTP Basic Auth
# Type: String (minimum 16 characters recommended)
# Required: Yes if using admin endpoints
# Security: CRITICAL - Use a strong, unique password
# Generate: openssl rand -base64 24
# Note: Consider using a password manager
ADMIN_PASSWORD=your_strong_admin_password_here

# =============================================================================
# MASTER PASSWORD (Database Stored)
# =============================================================================
#
# IMPORTANT: The master password is NOT stored in environment variables!
# It is stored as an Argon2 hash in the Supabase database (auth_config table).
#
# To set/update the master password:
# 1. Generate Argon2 hash: node scripts/generate-hash.js "YourMasterPassword"
# 2. Update database: UPDATE auth_config SET password_hash = '...' WHERE id = 1
#
# For development/testing, the seed script creates a default password.
# ⚠️  ALWAYS change this in production!
#
# Default development password: MasterPassword123!
# =============================================================================

# =============================================================================
# DEVELOPMENT/TESTING ONLY
# =============================================================================
# These variables are only for development and testing environments.
# ⚠️  DO NOT USE IN PRODUCTION!

# Test application credentials (seeded by scripts/seed.js)
# These are used for integration testing only
# TEST_APP_ID=test-app
# TEST_APP_SECRET=test-secret-123

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================

# Custom log level (if different from NODE_ENV default)
# Type: String (error | warn | info | debug)
# LOG_LEVEL=info

# Custom log file path
# Type: String (file path)
# LOG_FILE_PATH=./logs/application.log

# Rate limiting configuration (requests per window)
# LOGIN_RATE_LIMIT=5
# LOGIN_RATE_WINDOW=60000

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
# ✅ All placeholder values replaced with production values
# ✅ JWT_SECRET is cryptographically secure (32+ characters)
# ✅ ADMIN_PASSWORD is strong and unique
# ✅ ALLOWED_ORIGINS only includes production domains
# ✅ NODE_ENV set to "production"
# ✅ Master password changed in database
# ✅ File permissions set to 600 (chmod 600 .env)
# ✅ .env file NOT committed to version control
# ✅ Backup of production .env stored securely
# ✅ Regular security audits scheduled
# =============================================================================
