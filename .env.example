# Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Authentication Configuration
# Note: Master password is now stored per-application in the applications table
# Development credentials (seeded by scripts/seed.js):
#   Master Password (for test-app): MasterPassword123!
#   ⚠️  CHANGE IN PRODUCTION!
JWT_SECRET=your_jwt_secret_here

# Token Configuration
TOKEN_EXPIRATION=3600

# CORS Configuration
# Comma-separated list of allowed origins for cross-origin requests
# For development, include your frontend URL (e.g., http://localhost:3000)
# For production, include your production domain (e.g., https://yourdomain.com)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Development Test Application
# These credentials are seeded by scripts/seed.js
# ⚠️  FOR DEVELOPMENT/TESTING ONLY - DO NOT USE IN PRODUCTION!
TEST_APP_ID=test-app
TEST_APP_SECRET=test-secret-123

# Admin Panel Configuration
# JWT-based authentication for admin endpoints
# ⚠️  CHANGE THESE IN PRODUCTION!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_here_different_from_main
ADMIN_SESSION_TIMEOUT=1800
